# copy to .env and fill in, .env is gitignored

# required, sensai runs on ollama cloud. key from https://ollama.com/settings/keys
OLLAMA_API_KEY=

# news + sentiment, free key (5 calls/min, 2y history) from https://massive.com (ex polygon.io)
MASSIVE_API_KEY=

# web search, free key (1000 searches/month, no card) from https://tavily.com
TAVILY_API_KEY=
